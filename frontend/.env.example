# Copy to .env.local for local overrides, or set these in the Vercel project.
# Every value below is OPTIONAL — the app builds and runs with none of them set.

# Canonical origin used for metadataBase, canonical tags and Open Graph URLs.
# Set this on the Vercel Production environment once the real domain is live.
# Without it, production falls back to the Vercel-generated domain, then to
# https://translyfter.com.
NEXT_PUBLIC_SITE_URL=https://apexcourrier.com

# Backend API root. Defaults to the live Render deployment when unset.
NEXT_PUBLIC_API_BASE_URL=https://veno-atlas-2.onrender.com/api

# Google Search Console verification token. The verification meta tag is only
# emitted when this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact form addresses. The backend whitelists which "from" addresses it will
# accept (backend/src/routes/email.js ALLOWED_SENDERS). Set these to an
# already-whitelisted address if the apexcourrier.com domain is not yet added
# there and verified in Resend.
NEXT_PUBLIC_CONTACT_SENDER=support@apexcourrier.com
NEXT_PUBLIC_CONTACT_INBOX=support@apexcourrier.com
